# Clerk frontend and backend credentials.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Host port used by Docker Compose.
STREAMMOCK_PORT=8080

# Clone storage. Values are bytes; TTL 0 keeps clones until manual deletion.
STREAMMOCK_CLONE_MAX_BYTES=1073741824
STREAMMOCK_USER_QUOTA_BYTES=5368709120
STREAMMOCK_CLONE_TTL_HOURS=0
STREAMMOCK_CLONE_JANITOR_MINUTES=30

# ClearKey packaging and license endpoint limits.
STREAMMOCK_PACKAGER_BIN=packager
STREAMMOCK_PACKAGER_TIMEOUT_MINUTES=10
STREAMMOCK_LICENSE_RATELIMIT_RPM=120
STREAMMOCK_LICENSE_RATELIMIT_BURST=20

# Existing proxy defaults.
STREAMMOCK_RATELIMIT_RPM=10
STREAMMOCK_RATELIMIT_BURST=5
STREAMMOCK_EPHEMERAL_TTL_MINUTES=60
STREAMMOCK_BBB_URL=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8

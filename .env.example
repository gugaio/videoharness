# Vídeo Harness — configuração local (copie para .env; não comite .env)

# ---- Portas expostas no host (dev) ----
VH_WEB_PORT=8080
VH_APP_PORT=3210
# Se a 3210 estiver ocupada no host (ex.: túnel SSH), suba com override:
#   VH_APP_PORT=3211 docker compose up -d
# O DNS interno do compose (app:3210) não é afetado.
# Playback do mock (capability URLs para devices/emuladores)
VH_MOCK_PORT=8081

# ---- Clerk (Fase 1: login) ----
# Publishable key também entra como build arg da imagem do mock.
VITE_CLERK_PUBLISHABLE_KEY=
# Secret key: usada pelo mock para verificar JWTs; nunca vai para o frontend.
CLERK_SECRET_KEY=

# ---- Comunicação interna app -> engines ----
# Token de serviço para o orquestrador chamar Lens/Mock (rede interna do compose).
VH_SERVICE_TOKEN=dev-internal-token
# Caminho do SQLite do histórico. O compose usa /data/history.sqlite no volume app-data.
VH_DATABASE_PATH=.video-harness-data/history.sqlite
# Em compose, Lens e Mock são alcançáveis por DNS de serviço:
#   LENS_URL=http://lens:8000
#   MOCK_URL=http://mock:8080

# ---- Quotas do StreamMock (passthrough) ----
STREAMMOCK_CLONE_MAX_BYTES=1073741824
STREAMMOCK_USER_QUOTA_BYTES=5368709120
STREAMMOCK_CLONE_TTL_HOURS=0

VIDEO_HARNESS_AI_PROVIDER=openai
VIDEO_HARNESS_AI_API_URL=https://api.openai.com/v1/chat/completions
VIDEO_HARNESS_AI_MODEL=gpt-5.5
VIDEO_HARNESS_AI_TIMEOUT_MS=45000
VIDEO_HARNESS_MEDIA_SAMPLE_MAX_BYTES=134217728
VIDEO_HARNESS_MEDIA_SAMPLE_MAX_TOTAL_BYTES=536870912
VIDEO_HARNESS_MEDIA_SAMPLE_MAX_SECONDS=60
# full (default): a contiguous ~60s window per variant, centered on the reported
#   incident time when available (or from the start without a time).
# sample: only start/middle/end, lower and distributed cost (documented MVP scope).
# The byte budgets are safety nets; the time budget defines normal coverage.
VIDEO_HARNESS_MEDIA_SAMPLE_MODE=full
# Record R1: HLS VOD clear/MPEG-TS only. The aggregate cap applies to all
# playlists and segments in the recording window.
VIDEO_HARNESS_RECORD_SEGMENT_MAX_BYTES=67108864
VIDEO_HARNESS_RECORD_MAX_TOTAL_BYTES=1073741824
VIDEO_HARNESS_RECORD_MAX_VARIANTS=8
# Docker Compose maps localhost stream URLs to host.docker.internal automatically.
# Outside Docker, set VIDEO_HARNESS_STREAM_LOCALHOST_ALIAS=localhost only for local development.
# Set only in your local shell, deployment secret store, or an ignored .env file.
VIDEO_HARNESS_AI_API_KEY=

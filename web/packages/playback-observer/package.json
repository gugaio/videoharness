{
  "name": "@streammock/playback-observer",
  "version": "0.1.0",
  "description": "Browser playback telemetry observer for HTML5 media and HLS.js.",
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./hls": {
      "types": "./dist/hls/index.d.ts",
      "import": "./dist/hls/index.js",
      "require": "./dist/hls/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "hls.js": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "hls.js": { "optional": true }
  },
  "devDependencies": {
    "hls.js": "1.7.1",
    "jsdom": "26.1.0",
    "tsup": "^8.0.0",
    "typescript": "~5.6.2",
    "vitest": "3.2.4"
  }
}